# PROOFWORK v2 — copy to .env (and apps/web/.env.local for Next mirrors).
# Live-only: missing required keys fail loudly at MCP boot. No mode switches.
# Required keys: see commented sections below (MCP boot fails if any REQUIRED block is empty).
# Docker Compose: `docker compose up --build` passes this file through.

# --- process / URLs ---
MCP_PORT=38472
PROOFWORK_PUBLIC_URL=http://127.0.0.1:38471
# Tunnel / phone IDKit — must match the public HTTPS host (no trailing slash).
# Also set the NEXT_PUBLIC_ mirror in apps/web/.env.local so the browser never
# falls back to window.localhost for World QR / Continuity.
# PROOFWORK_PUBLIC_URL=https://pfw.alanchris.me
# NEXT_PUBLIC_PROOFWORK_PUBLIC_URL=https://pfw.alanchris.me
# Optional absolute MCP URL for Next rewrite / scripts (default http://127.0.0.1:38472)
# PROOFWORK_MCP_URL=http://127.0.0.1:38472
# MCP_URL=http://127.0.0.1:38472

# OpenCode / official MCP stdio bridge (apps/mcp/src/stdio-mcp.ts)
# Prefer http so OpenCode + web Review inbox share one MCP compose.
# PROOFWORK_MCP_BRIDGE=http
# PROOFWORK_MCP_HTTP=http://127.0.0.1:38472
# PROOFWORK_MCP_HTTP=https://<deploy>/api/mcp
# PROOFWORK_CONNECT_TOKEN=pwct_…
# HTTP MCP also accepts Authorization: Bearer <token> and/or X-PROOFWORK-CONNECT

# Browser MCP base (default /api/mcp → Next rewrite to MCP_PORT)
# NEXT_PUBLIC_PROOFWORK_MCP_URL=/api/mcp
# NEXT_PUBLIC_PROOFWORK_MCP_HTTP=https://<deploy>/api/mcp

# World session cookie (Sign in with World ID). Dev default is fine locally.
# PROOFWORK_SESSION_SECRET=change-me-in-prod
# MCP pot/account registry on disk (survives MCP restart). Default .data/accounts.json
# PROOFWORK_ACCOUNTS_PATH=/abs/path/accounts.json
# PROOFWORK_ACCOUNTS_PATH=off   # in-memory only (tests)

# --- World Agent Pass + Sign in with World ID (REQUIRED) ---
# Registered redirect (prod): https://pfw.alanchris.me/api/world/approve/callback
WORLD_AGENT_PASS_CLIENT_ID=
WORLD_AGENT_PASS_CLIENT_SECRET=
WORLD_AGENT_PASS_REDIRECT_URI=http://127.0.0.1:38471/api/world/approve/callback
WORLD_AGENT_PASS_ISSUER=https://auth.world.org
WORLD_AGENT_PASS_MAX_AGE=0
WORLD_AGENT_PASS_APPROVAL_TTL=600
WORLD_AGENT_PASS_CLOCK_TOLERANCE=30
# Optional login overrides (default = Agent Pass client / redirect / issuer):
# WORLD_OIDC_CLIENT_ID=
# WORLD_OIDC_CLIENT_SECRET=
# WORLD_OIDC_REDIRECT_URI=https://pfw.alanchris.me/api/world/approve/callback
# WORLD_OIDC_ISSUER=https://auth.world.org

# --- World IDKit Proof of Human (REQUIRED — gig claim) ---
WORLD_IDKIT_APP_ID=
WORLD_IDKIT_RP_ID=
WORLD_IDKIT_ACCEPT_ACTION=proofwork-accept
# Server-only. Never expose to the browser / never prefix NEXT_PUBLIC_.
WORLD_IDKIT_RP_SIGNING_KEY=
WORLD_IDKIT_ENVIRONMENT=production
WORLD_IDKIT_VERIFY_BASE_URL=https://developer.world.org/api/v4/verify

# --- Hedera HCS (REQUIRED) ---
HEDERA_HCS_TOPIC_ID=
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_NETWORK=testnet

# --- Arkiv (REQUIRED) ---
# Rabdi RPC; path may include /ark_live_… access key.
ARKIV_RPC_URL=
# Funded tGLM key for entity writes (required at MCP boot):
ARKIV_PRIVATE_KEY=

# --- Hedera x402 (REQUIRED) ---
X402_PAY_TO=
X402_FACILITATOR_URL=
# X402_ASSET=
# X402_PRICE_BASE_UNITS=

# --- Fund pot (RainbowKit / wagmi) ---
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# NEXT_PUBLIC_CHAIN_ID=296
# NEXT_PUBLIC_HEDERA_RPC_URL=https://testnet.hashio.io/api
# HEDERA_RPC_URL=https://testnet.hashio.io/api
# NEXT_PUBLIC_BUDGET_POT_ADDRESS=0x…
# BUDGET_POT_ADDRESS=0x…
# GIG_ESCROW_ADDRESS=0x…
# NEXT_PUBLIC_GIG_ESCROW_ADDRESS=0x…
# NEXT_PUBLIC_ESCROW_ADDRESS=0x…

# --- On-chain worker payout (all_satisfied) ---
# PAYOUT_PRIVATE_KEY=0x…   # 0x + 64 hex — NOT a Hedera DER operator key
# HEDERA_OPERATOR_EVM_KEY=0x…   # alias
