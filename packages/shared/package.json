{
  "name": "@proofwork/shared",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "import": "./dist/ports/index.js"
    },
    "./compose": {
      "types": "./dist/compose.d.ts",
      "import": "./dist/compose.js"
    },
    "./compose-test": {
      "types": "./dist/compose-test.d.ts",
      "import": "./dist/compose-test.js"
    },
    "./attachments": {
      "types": "./dist/adapters/attachments/disk.d.ts",
      "import": "./dist/adapters/attachments/disk.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 $(find src -name '*.test.ts')"
  },
  "dependencies": {
    "@arkiv-network/sdk": "^1.0.1",
    "jose": "^6.0.11",
    "viem": "^2.57.16",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@worldcoin/idkit-core": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
